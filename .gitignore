# ── Dependencies & build output (recreated by `npm ci` and `npm run build`) ──
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# ── Packaged extensions and signing keys — never publish these ──
# A .pem is the private key Chrome creates when you "Pack extension".
*.pem
*.crx
*.xpi
*.zip
web-ext-artifacts/

# ── Secrets & local environment ──
.env
.env.*
*.key
*.p12
secrets/

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Editor, AI-assistant and OS files ──
.claude/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local planning notes (not needed to build or run Webinel) ──
webinel.md
